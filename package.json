{
  "name": "@vvornanen/aoboshi",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "lint": "eslint .",
    "test:rebuild": "pnpm rebuild better-sqlite3",
    "test": "pnpm test:rebuild && vitest --project '!anki (integration)'",
    "test:integration": "vitest --project 'anki (integration)'",
    "test:storybook": "vitest --project 'app (storybook)'",
    "build": "pnpm --recursive build",
    "schema": "sqlite3 packages/aoboshi-app/dev.db .schema > packages/aoboshi-app/src/migrations/schema.sql",
    "dev": "concurrently 'pnpm build --watch' 'pnpm storybook'",
    "package": "pnpm --filter @vvornanen/aoboshi-app package && open packages/aoboshi-app/out",
    "package:ci": "pnpm --filter @vvornanen/aoboshi-app package",
    "make": "pnpm --filter @vvornanen/aoboshi-app make && open packages/aoboshi-app/out",
    "start": "pnpm --filter @vvornanen/aoboshi-app start",
    "storybook": "pnpm --filter @vvornanen/aoboshi-app storybook",
    "chromatic": "pnpm --filter @vvornanen/aoboshi-app chromatic --exit-zero-on-changes"
  },
  "lint-staged": {
    "*.{html,css,md,mdx,json}": "prettier --write",
    "*.{js,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.9",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2",
    "vitest-mock-extended": "^5.1.1"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "~24.17.0",
      "onFail": "download"
    }
  }
}
