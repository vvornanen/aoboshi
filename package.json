{
  "name": "@vvornanen/aoboshi",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "lint": "eslint .",
    "test:rebuild": "pnpm rebuild better-sqlite3",
    "test": "pnpm test:rebuild && vitest --project !anki/integration",
    "test:integration": "vitest --project anki/integration",
    "test:storybook": "vitest --project app/storybook",
    "build": "pnpm --recursive build",
    "schema": "sqlite3 packages/aoboshi-app/dev.db .schema > packages/aoboshi-app/src/migrations/schema.sql",
    "dev": "concurrently 'pnpm build --watch' 'pnpm storybook'",
    "package": "pnpm --filter @vvornanen/aoboshi-app package && open packages/aoboshi-app/out",
    "package:ci": "pnpm --filter @vvornanen/aoboshi-app package",
    "make": "pnpm --filter @vvornanen/aoboshi-app make && open packages/aoboshi-app/out",
    "start": "pnpm --filter @vvornanen/aoboshi-app start",
    "storybook": "pnpm --filter @vvornanen/aoboshi-app storybook",
    "chromatic": "pnpm --filter @vvornanen/aoboshi-app chromatic --exit-zero-on-changes"
  },
  "lint-staged": {
    "*.{html,css,md,mdx,json}": "prettier --write",
    "*.{js,ts,tsx,mjs}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "22.19.3",
    "@vitest/coverage-v8": "^4.0.16",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "10.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "storybook": "10.1.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "vitest-mock-extended": "^3.1.0"
  },
  "resolutions": {
    "@vitejs/plugin-react": ">=4.2.1"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "~22.20.0",
      "onFail": "download"
    }
  }
}
